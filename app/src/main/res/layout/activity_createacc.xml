<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6"
    android:padding="28dp">

    <TextView
        android:id="@+id/createAccountTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_account_title"
        android:textColor="#6F35A8"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="65dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/createAccountSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_account_subtitle"
        android:textColor="#0B090A"
        android:textSize="14sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/createAccountTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/nameInput"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="@string/full_name"
        android:inputType="textPersonName"
        android:autofillHints="personName"
        android:padding="14dp"
        android:textColor="#0B090A"
        android:textColorHint="#59545C"
        android:backgroundTint="#9B5DE5"
        android:layout_marginTop="45dp"
        app:layout_constraintTop_toBottomOf="@id/createAccountSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="300dp"/>

    <EditText
        android:id="@+id/registerEmailInput"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="@string/email_address"
        android:inputType="textEmailAddress"
        android:autofillHints="emailAddress"
        android:padding="14dp"
        android:textColor="#0B090A"
        android:textColorHint="#59545C"
        android:backgroundTint="#9B5DE5"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/nameInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="300dp"/>

    <EditText
        android:id="@+id/registerPasswordInput"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="@string/password"
        android:inputType="textPassword"
        android:autofillHints="newPassword"
        android:padding="14dp"
        android:textColor="#0B090A"
        android:textColorHint="#59545C"
        android:backgroundTint="#9B5DE5"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/registerEmailInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="300dp"/>

    <EditText
        android:id="@+id/confirmPasswordInput"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="@string/confirm_password"
        android:inputType="textPassword"
        android:autofillHints="newPassword"
        android:padding="14dp"
        android:textColor="#0B090A"
        android:textColorHint="#59545C"
        android:backgroundTint="#9B5DE5"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/registerPasswordInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="300dp"/>

    <Button
        android:id="@+id/registerButton"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/create_account_button"
        android:textColor="#0B090A"
        android:backgroundTint="#00C9B7"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/confirmPasswordInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="300dp"/>

    <TextView
        android:id="@+id/backToLoginText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/already_have_account"
        android:textColor="#6F35A8"
        android:textSize="14sp"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@id/registerButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
